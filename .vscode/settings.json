{
  "python.defaultInterpreterPath": "${workspaceFolder}/slop/backend/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/slop/backend",
    "${workspaceFolder}/scripts",
    "${workspaceFolder}/slop/backend/.venv/Lib/site-packages"
  ],
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "none",
    "reportMissingTypeStubs": "none",
    "reportAttributeAccessIssue": "none",
    "reportGeneralTypeIssues": "none",
    "reportOperatorIssue": "none",
    "reportArgumentType": "none",
    "reportIndexIssue": "none",
    "reportCallIssue": "none",
    "reportOptionalCall": "none"
  },
  "basedpyright.analysis.typeCheckingMode": "off",
  "basedpyright.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "none",
    "reportMissingTypeStubs": "none",
    "reportAttributeAccessIssue": "none",
    "reportGeneralTypeIssues": "none",
    "reportOperatorIssue": "none",
    "reportArgumentType": "none",
    "reportIndexIssue": "none",
    "reportCallIssue": "none",
    "reportOptionalCall": "none"
  },
  "files.exclude": {
    "**/.pytest_cache": true,
    "**/__pycache__": true
  }
}
