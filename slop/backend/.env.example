APP_ENV=development
APP_NAME=SLOP
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql+asyncpg://slop:sloppassword@postgres:5432/slopdb
REDIS_URL=redis://:redispassword@redis:6379/0
SECRET_KEY=replace-with-openssl-rand-hex-64
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=15
VERIFICATION_TOKEN_EXPIRE_HOURS=24
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@slop.dev
SUPPORT_EMAIL=support@slop.dev
MARKETING_UNSUBSCRIBE_URL=https://slop.dev/unsubscribe
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANALYST=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_ENTERPRISE=
BILLING_SUCCESS_URL=http://localhost:3000/billing?checkout=success
BILLING_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled
UPLOAD_DIR=./uploads
MAX_TEXT_FILE_MB=20
MAX_IMAGE_FILE_MB=50
MAX_VIDEO_FILE_MB=500
HUGGINGFACE_CACHE_DIR=./models
DEVICE=cpu
